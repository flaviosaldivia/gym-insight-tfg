# Solo para Docker Compose local. Cambiar estas credenciales si se comparte el entorno.
POSTGRES_DB=gym_bi
POSTGRES_USER=gym_user
POSTGRES_PASSWORD=gym_password
DATABASE_URL=postgresql+psycopg://gym_user:gym_password@postgres:5432/gym_bi
FRONTEND_ORIGINS=http://localhost:5173
# En desarrollo local se deja vacío; para despliegue independiente se usa la URL pública de FastAPI.
VITE_API_URL=
